{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dispatcher/dispatch.ts\"", "timeout": 600 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dispatcher/dispatch.ts\"", "timeout": 120 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dispatcher/dispatch.ts\"", "timeout": 600 }
        ]
      },
      {
        "hooks": [
          {
            "type": "prompt",
            "timeout": 30,
            "model": "claude-haiku-5-5",
            "statusMessage": "ask-don't-dump-issues checker",
            "prompt": "@ask-dont-dump-prompt.md"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dispatcher/dispatch.ts\"", "timeout": 600 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dispatcher/dispatch.ts\"", "timeout": 120 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dispatcher/dispatch.ts\"", "timeout": 120 }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dispatcher/dispatch.ts\"", "timeout": 120 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/dispatcher/dispatch.ts\"", "timeout": 120 }
        ]
      }
    ]
  }
}
