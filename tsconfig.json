{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["*.d.ts", "dispatcher/**/*.ts", "shared/**/*.ts"],
  "exclude": ["node_modules"]
}
