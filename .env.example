CLAUDE_HOOKS_LIST=dispatcher/hooks-list.ts
CLAUDE_HOOKS_PLANNING_GUIDE_PATH=/path/to/planning.md  # path of the planning guide named in the plan-edit reminder
CLAUDE_HOOKS_TASKS_DIR=/path/to/.claude/tasks  # folder holding one folder per task list; full path
CLAUDE_HOOKS_UNLISTED_MIN_WORD_LENGTH=5  # a word needs this many letters to count in the overlap match
CLAUDE_HOOKS_UNLISTED_MIN_SHARED_WORDS=2  # a line is listed when it shares this many counted words with an open task
CLAUDE_HOOKS_BLOCKED_EDITS_DIR=/path/to/claude-blocked-edits  # folder where blocked tool calls are saved as JSON
CLAUDE_HOOKS_BLOCK_NPM_TEST_LOG_DIR=/path/to/npm-test-logs  # folder for test run logs
CLAUDE_HOOKS_BLOCK_NPM_TEST_KILL_AFTER_SECONDS=3600  # seconds before the timer kills a background test run
CLAUDE_HOOKS_BLOCK_NPM_TEST_TEST_TIMEOUT_MS=120000  # per-test timeout passed to node --test and bun test
CLAUDE_HOOKS_BLOCK_NPM_TEST_LOG_MAX_AGE_MS=604800000  # logs older than this (7 days) are removed
CLAUDE_HOOKS_BLOCK_NPM_TEST_MONITOR_WAIT_SECONDS=240  # default wait of monitor-test-run.ts
CLAUDE_HOOKS_BLOCK_NPM_TEST_MONITOR_POLL_SECONDS=2  # seconds between monitor checks for the .done file
# typecheck-on-stop: the most tsc error lines shown to the agent
CLAUDE_HOOKS_TYPECHECK_MAX_ERROR_LINES=20
# clarify-ambiguous: a prompt with this many words or fewer is checked for ambiguity
CLAUDE_HOOKS_CLARIFY_AMBIGUOUS_MAX_WORDS=15
# status-line: weekly countdown shows only when fewer than this many hours remain
CLAUDE_HOOKS_STATUS_LINE_WEEKLY_RESET_SHOW_HOURS=12
# status-line: weekly countdown turns yellow below this many minutes
CLAUDE_HOOKS_STATUS_LINE_WEEKLY_RESET_YELLOW_MINUTES=180
# status-line: weekly countdown turns orange below this many minutes
CLAUDE_HOOKS_STATUS_LINE_WEEKLY_RESET_ORANGE_MINUTES=360
# status-line: weekly countdown turns red below this many minutes
CLAUDE_HOOKS_STATUS_LINE_WEEKLY_RESET_RED_MINUTES=540
# status-line: folder searched for the claude- scratch folders of workflow agents
CLAUDE_HOOKS_STATUS_LINE_SCRATCH_ROOT=/tmp
# status-line: session state files older than this many days are removed
CLAUDE_HOOKS_STATUS_LINE_KEEP_DAYS=14
# status-line: weekly usage turns red when fewer points than this are left in the day's budget
CLAUDE_HOOKS_STATUS_LINE_WEEKLY_RED_POINTS_LEFT=2
# status-line: weekly usage turns orange when fewer points than this are left in the day's budget
CLAUDE_HOOKS_STATUS_LINE_WEEKLY_ORANGE_POINTS_LEFT=5
# status-line: weekly usage turns yellow when fewer points than this are left in the day's budget
CLAUDE_HOOKS_STATUS_LINE_WEEKLY_YELLOW_POINTS_LEFT=8
# status-line: token count at which the color turns yellow
CLAUDE_HOOKS_STATUS_LINE_TOKENS_YELLOW_AT=75000
# status-line: token count at which the color turns orange
CLAUDE_HOOKS_STATUS_LINE_TOKENS_ORANGE_AT=100000
# status-line: token count at which the color turns red
CLAUDE_HOOKS_STATUS_LINE_TOKENS_RED_AT=150000
# status-line: context window percent at which the bar turns yellow
CLAUDE_HOOKS_STATUS_LINE_CONTEXT_YELLOW_AT=15
# status-line: context window percent at which the bar turns orange
CLAUDE_HOOKS_STATUS_LINE_CONTEXT_ORANGE_AT=20
# status-line: context window percent at which the bar turns red
CLAUDE_HOOKS_STATUS_LINE_CONTEXT_RED_AT=25
# status-line: turn count at which the color turns yellow
CLAUDE_HOOKS_STATUS_LINE_TURNS_YELLOW_AT=7
# status-line: turn count at which the color turns orange
CLAUDE_HOOKS_STATUS_LINE_TURNS_ORANGE_AT=10
# status-line: turn count at which the color turns red
CLAUDE_HOOKS_STATUS_LINE_TURNS_RED_AT=13
# status-line: day of the week at which the color turns yellow
CLAUDE_HOOKS_STATUS_LINE_DAY_YELLOW_AT=5
# status-line: day of the week at which the color turns orange
CLAUDE_HOOKS_STATUS_LINE_DAY_ORANGE_AT=6
# status-line: day of the week at which the color turns red
CLAUDE_HOOKS_STATUS_LINE_DAY_RED_AT=7
# status-line: five hour usage percent at which the color turns yellow
CLAUDE_HOOKS_STATUS_LINE_FIVE_HOUR_YELLOW_AT=51
# status-line: five hour usage percent at which the color turns orange
CLAUDE_HOOKS_STATUS_LINE_FIVE_HOUR_ORANGE_AT=76
# status-line: five hour usage percent at which the color turns red
CLAUDE_HOOKS_STATUS_LINE_FIVE_HOUR_RED_AT=91
# status-line: JSON list of [minutes until reset, [usage percent where levels 2 to 6 begin]]; one line, no quotes
CLAUDE_HOOKS_STATUS_LINE_ANNOYANCE_ANCHORS=[[0,[95,99,102,102,102]],[20,[85,95,98,102,102]],[45,[70,74,78,82,90]],[80,[66,72,78,82,90]],[150,[58,64,70,74,82]]]
