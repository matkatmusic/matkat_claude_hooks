# Per-hook values go in the env object of the hook's entry in the list file that CLAUDE_HOOKS_LIST points to. See README.md.
CLAUDE_HOOKS_LIST=dispatcher/hooks-list.ts
# session state: folder holding one JSON file per session; full path, ~ is not expanded
CLAUDE_HOOKS_SESSION_STATE_DIR=/path/to/home/.claude/claude_hooks
# idle-state: folder in the project that holds the state files; the reader and the mod share it
CLAUDE_HOOKS_IDLE_STATE_FOLDER_NAME=.idleState
