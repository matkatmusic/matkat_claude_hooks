flowchart TD
    B_AGENT_REPLY["Agent reply"]
%% %% Layer 1 query
    Q_ABOUT{"What is the reply about?"}
%% %% Layer 2 query
    Q_DOES{"What does the reply do?"}
%% %% Layer 1 choices
    Q_CHOICE_ABOUT_WORK_PASS["'work or task' > threshold"]
    Q_CHOICE_ABOUT_WORK_FAIL["'work or task' ≤ threshold"]
    Q_CHOICE_ABOUT_CHECK_PASS["'a check or test' > threshold"]
    Q_CHOICE_ABOUT_CHECK_FAIL["'a check or test' ≤ threshold"]
    Q_CHOICE_ABOUT_CODE_PASS["'the code' > threshold"]
    Q_CHOICE_ABOUT_CODE_FAIL["'the code' ≤ threshold"]
    Q_CHOICE_ABOUT_DECISION_PASS["'a question or decision' > threshold"]
    Q_CHOICE_ABOUT_DECISION_FAIL["'a question or decision' ≤ threshold"]
    Q_CHOICE_ABOUT_HELPER_PASS["'a helper' > threshold"]
    Q_CHOICE_ABOUT_HELPER_FAIL["'a helper' ≤ threshold"]
    Q_CHOICE_ABOUT_TASK_LIST_PASS["'the task list' > threshold"]
    Q_CHOICE_ABOUT_TASK_LIST_FAIL["'the task list' ≤ threshold"]
    Q_CHOICE_ABOUT_PLAN_PASS["'the method or plan' > threshold"]
    Q_CHOICE_ABOUT_PLAN_FAIL["'the method or plan' ≤ threshold"]
    Q_CHOICE_ABOUT_OTHER_SESSION_PASS["'another session' > threshold"]
    Q_CHOICE_ABOUT_OTHER_SESSION_FAIL["'another session' ≤ threshold"]
    Q_CHOICE_ABOUT_BUG_PASS["'a bug or problem' > threshold"]
    Q_CHOICE_ABOUT_BUG_FAIL["'a bug or problem' ≤ threshold"]
    B_DO_NOT_BLOCK["Do not block reply"]

%% %% Layer 1 logic
    B_AGENT_REPLY --> Q_ABOUT

    %% %% all scores above threshold advance to next question
    Q_ABOUT --> Q_CHOICE_ABOUT_WORK_PASS --> Q_DOES
    Q_ABOUT --> Q_CHOICE_ABOUT_CHECK_PASS --> Q_DOES
    Q_ABOUT --> Q_CHOICE_ABOUT_CODE_PASS --> Q_DOES
    Q_ABOUT --> Q_CHOICE_ABOUT_DECISION_PASS --> Q_DOES
    Q_ABOUT --> Q_CHOICE_ABOUT_HELPER_PASS --> Q_DOES
    Q_ABOUT --> Q_CHOICE_ABOUT_TASK_LIST_PASS --> Q_DOES
    Q_ABOUT --> Q_CHOICE_ABOUT_PLAN_PASS --> Q_DOES
    Q_ABOUT --> Q_CHOICE_ABOUT_OTHER_SESSION_PASS --> Q_DOES
    Q_ABOUT --> Q_CHOICE_ABOUT_BUG_PASS --> Q_DOES

    %% %% all scores below threshold go to 'do not block'
    Q_ABOUT --> Q_CHOICE_ABOUT_WORK_FAIL --> B_DO_NOT_BLOCK
    Q_ABOUT --> Q_CHOICE_ABOUT_CHECK_FAIL --> B_DO_NOT_BLOCK
    Q_ABOUT --> Q_CHOICE_ABOUT_CODE_FAIL --> B_DO_NOT_BLOCK
    Q_ABOUT --> Q_CHOICE_ABOUT_DECISION_FAIL --> B_DO_NOT_BLOCK
    Q_ABOUT --> Q_CHOICE_ABOUT_HELPER_FAIL --> B_DO_NOT_BLOCK
    Q_ABOUT --> Q_CHOICE_ABOUT_TASK_LIST_FAIL --> B_DO_NOT_BLOCK
    Q_ABOUT --> Q_CHOICE_ABOUT_PLAN_FAIL --> B_DO_NOT_BLOCK
    Q_ABOUT --> Q_CHOICE_ABOUT_OTHER_SESSION_FAIL --> B_DO_NOT_BLOCK
    Q_ABOUT --> Q_CHOICE_ABOUT_BUG_FAIL --> B_DO_NOT_BLOCK

%% %% Layer 2 choices
    Q_CHOICE_DOES_FACT_PASS["'states a fact' > threshold"]
    Q_CHOICE_DOES_FACT_FAIL["'states a fact' ≤ threshold"]
    Q_CHOICE_DOES_QUESTION_PASS["'asks a question' > threshold"]
    Q_CHOICE_DOES_QUESTION_FAIL["'asks a question' ≤ threshold"]
    Q_CHOICE_DOES_OFFER_PASS["'offers to do something or asks for approval' > threshold"]
    Q_CHOICE_DOES_OFFER_FAIL["'offers to do something or asks for approval' ≤ threshold"]
    Q_CHOICE_DOES_CHOICES_PASS["'gives choices with no pick' > threshold"]
    Q_CHOICE_DOES_CHOICES_FAIL["'gives choices with no pick' ≤ threshold"]
    Q_CHOICE_DOES_DECISION_PASS["'records a decision the user made' > threshold"]
    Q_CHOICE_DOES_DECISION_FAIL["'records a decision the user made' ≤ threshold"]
    Q_CHOICE_DOES_ANSWER_PASS["'answers a question with a confirmed answer' > threshold"]
    Q_CHOICE_DOES_ANSWER_FAIL["'answers a question with a confirmed answer' ≤ threshold"]
    Q_CHOICE_DOES_INSTRUCTION_PASS["'tells the user to do something' > threshold"]
    Q_CHOICE_DOES_INSTRUCTION_FAIL["'tells the user to do something' ≤ threshold"]
    Q_CHOICE_DOES_GUESS_PASS["'states a guess, a gap, or an unconfirmed answer' > threshold"]
    Q_CHOICE_DOES_GUESS_FAIL["'states a guess, a gap, or an unconfirmed answer' ≤ threshold"]
%% %% Layer 2 logic
    %% all layer 2 scores below threshold go to 'do not block'
    Q_DOES --> Q_CHOICE_DOES_FACT_FAIL --> B_DO_NOT_BLOCK
    Q_DOES --> Q_CHOICE_DOES_QUESTION_FAIL --> B_DO_NOT_BLOCK
    Q_DOES --> Q_CHOICE_DOES_OFFER_FAIL --> B_DO_NOT_BLOCK
    Q_DOES --> Q_CHOICE_DOES_CHOICES_FAIL --> B_DO_NOT_BLOCK
    Q_DOES --> Q_CHOICE_DOES_DECISION_FAIL --> B_DO_NOT_BLOCK
    Q_DOES --> Q_CHOICE_DOES_ANSWER_FAIL --> B_DO_NOT_BLOCK
    Q_DOES --> Q_CHOICE_DOES_INSTRUCTION_FAIL --> B_DO_NOT_BLOCK
    Q_DOES --> Q_CHOICE_DOES_GUESS_FAIL --> B_DO_NOT_BLOCK

%% %% Layer 3 queries
    Q_WHO{"Who must act next, and when?"}
    Q_ASKED{"Did the user ask for this instruction?"}
    Q_LISTED{"Is all the work Claude owes already on the task list?"}
%% %% Layer 3 choices
    Q_CHOICE_WHO_CLAUDE_NOW_PASS["'Claude, starting work with several steps now' > threshold"]
    Q_CHOICE_WHO_CLAUDE_NOW_FAIL["'Claude, starting work with several steps now' ≤ threshold"]
    Q_CHOICE_WHO_CLAUDE_LATER_PASS["'Claude, after this turn' > threshold"]
    Q_CHOICE_WHO_CLAUDE_LATER_FAIL["'Claude, after this turn' ≤ threshold"]
    Q_CHOICE_WHO_HELPER_PASS["'a helper, during this turn' > threshold"]
    Q_CHOICE_WHO_HELPER_FAIL["'a helper, during this turn' ≤ threshold"]
    Q_CHOICE_WHO_USER_PASS["'the user, after this turn' > threshold"]
    Q_CHOICE_WHO_USER_FAIL["'the user, after this turn' ≤ threshold"]
    Q_CHOICE_WHO_NOBODY_DONE_PASS["'nobody: the work is done' > threshold"]
    Q_CHOICE_WHO_NOBODY_DONE_FAIL["'nobody: the work is done' ≤ threshold"]
    Q_CHOICE_ASKED_YES_PASS["'yes, the user asked for it' > threshold"]
    Q_CHOICE_ASKED_YES_FAIL["'yes, the user asked for it' ≤ threshold"]
    Q_CHOICE_ASKED_NO_PASS["'no, the user did not ask for it' > threshold"]
    Q_CHOICE_ASKED_NO_FAIL["'no, the user did not ask for it' ≤ threshold"]
    Q_CHOICE_LISTED_YES_PASS["'yes, all of it is on the task list' > threshold"]
    Q_CHOICE_LISTED_YES_FAIL["'yes, all of it is on the task list' ≤ threshold"]
    Q_CHOICE_LISTED_NO_PASS["'no, some of it is not on the task list' > threshold"]
    Q_CHOICE_LISTED_NO_FAIL["'no, some of it is not on the task list' ≤ threshold"]
    Q_CHOICE_WHO_NOBODY_OPEN_PASS["'nobody yet: the work is still open' > threshold"]
    Q_CHOICE_WHO_NOBODY_OPEN_FAIL["'nobody yet: the work is still open' ≤ threshold"]
    B_BLOCK_ASK["Block reply: use AskUserQuestion"]
    B_BLOCK_TASK["Block reply: use TaskCreate"]
%% %% Layer 3 logic
    %% %% a question, an offer, choices with no pick, or a guess always needs AskUserQuestion
    Q_DOES --> Q_CHOICE_DOES_QUESTION_PASS --> B_BLOCK_ASK
    Q_DOES --> Q_CHOICE_DOES_OFFER_PASS --> B_BLOCK_ASK
    Q_DOES --> Q_CHOICE_DOES_CHOICES_PASS --> B_BLOCK_ASK
    Q_DOES --> Q_CHOICE_DOES_GUESS_PASS --> B_BLOCK_ASK
    %% %% a recorded user decision or an answer needs nothing
    Q_DOES --> Q_CHOICE_DOES_DECISION_PASS --> B_DO_NOT_BLOCK
    Q_DOES --> Q_CHOICE_DOES_ANSWER_PASS --> B_DO_NOT_BLOCK

    %% %% an instruction to the user blocks, unless the user asked for it
    Q_DOES --> Q_CHOICE_DOES_INSTRUCTION_PASS --> Q_ASKED
    Q_ASKED --> Q_CHOICE_ASKED_YES_PASS --> B_DO_NOT_BLOCK
    Q_ASKED --> Q_CHOICE_ASKED_NO_PASS --> B_BLOCK_ASK

    %% %% a fact can still say that Claude owes more work
    Q_WHO --> Q_CHOICE_WHO_CLAUDE_NOW_PASS --> Q_LISTED
    Q_WHO --> Q_CHOICE_WHO_CLAUDE_LATER_PASS --> Q_LISTED
    Q_WHO --> Q_CHOICE_WHO_HELPER_PASS --> B_DO_NOT_BLOCK
    Q_WHO --> Q_CHOICE_WHO_USER_PASS --> Q_ASKED
    Q_WHO --> Q_CHOICE_WHO_NOBODY_DONE_PASS --> B_DO_NOT_BLOCK
    Q_WHO --> Q_CHOICE_WHO_NOBODY_OPEN_PASS --> Q_LISTED

    %% %% work that Claude owes blocks, unless it is on the task list
    Q_LISTED --> Q_CHOICE_LISTED_YES_PASS --> B_DO_NOT_BLOCK
    Q_LISTED --> Q_CHOICE_LISTED_NO_PASS --> B_BLOCK_TASK

    %% %% all layer 3 scores below threshold go to 'do not block'
    Q_WHO --> Q_CHOICE_WHO_CLAUDE_NOW_FAIL --> B_DO_NOT_BLOCK
    Q_WHO --> Q_CHOICE_WHO_CLAUDE_LATER_FAIL --> B_DO_NOT_BLOCK
    Q_WHO --> Q_CHOICE_WHO_HELPER_FAIL --> B_DO_NOT_BLOCK
    Q_WHO --> Q_CHOICE_WHO_USER_FAIL --> B_DO_NOT_BLOCK
    Q_WHO --> Q_CHOICE_WHO_NOBODY_DONE_FAIL --> B_DO_NOT_BLOCK
    Q_ASKED --> Q_CHOICE_ASKED_YES_FAIL --> B_DO_NOT_BLOCK
    Q_ASKED --> Q_CHOICE_ASKED_NO_FAIL --> B_DO_NOT_BLOCK
    Q_LISTED --> Q_CHOICE_LISTED_YES_FAIL --> B_DO_NOT_BLOCK
    Q_LISTED --> Q_CHOICE_LISTED_NO_FAIL --> B_DO_NOT_BLOCK
    Q_WHO --> Q_CHOICE_WHO_NOBODY_OPEN_FAIL --> B_DO_NOT_BLOCK



    B_ASK_GATE["Ask gate opens"]
    B_TASK_GATE["Task gate opens"]
    B_NO_GATE["No gate opens from this answer"]

