  Q_NEW_1{"Is this fact about a bug or codebase issue?"}
  Q_CHOICE_NEW_1_Y["'About a bug or codebase issue' > threshold"]
  Q_CHOICE_NEW_1_N["'About a bug or issue' <= threshold"]
  Q_CHOICE_DOES_FACT_PASS --> Q_NEW_1
  Q_NEW_1 --> Q_CHOICE_NEW_1_Y
  Q_NEW_1 --> Q_CHOICE_NEW_1_N
  Q_DOES --> Q_CHOICE_DOES_FACT_PASS
  Q_CHOICE_NEW_1_N --> B_DO_NOT_BLOCK
  Q_CHOICE_NEW_1_Y --> B_TASK_GATE
