flowchart TD
    B_AGENT_REPLY["Agent reply"]

    B_EXTRACT["Extract distinct items from reply"]
    B_NORMALIZE["Normalize each item: subject, action, status, owner, dependencies"]
    B_INIT["Initialize AskQuestions = [] and TaskItems = []"]
    Q_MORE_ITEMS{"Are there unprocessed items?"}

    B_SELECT["Select next item"]

    %% ASK USER QUESTION TREE
    Q_ASK_WALK{"Q1: Does this item require AskUserQuestion?"}
    Q_EXPLICIT{"Does the item explicitly ask the user a question or request a decision?"}
    Q_BLOCKED{"Does the item describe work blocked by missing user input?"}
    Q_AMBIGUOUS{"Does the item contain ambiguity that prevents required work?"}
    Q_PERMISSION{"Does the item require user authorization or approval?"}

    B_ADD_ASK["Append required question to AskQuestions"]

    %% TASK TREE
    Q_TASK_WALK{"Q2: Does this item require a TaskList entry?"}
    Q_ACTION{"Does the item describe concrete unfinished work?"}
    Q_COMMITMENT{"Does the item contain an outstanding agent commitment?"}
    Q_BUG{"Does the item report an unresolved bug, failure, or issue?"}
    Q_PENDING{"Does the item describe a pending action needed to complete the request?"}
    Q_OWNED{"Is the work already assigned to a helper?"}
    Q_TRACKED{"Is the work already covered by the TaskList?"}

    B_ADD_TASK["Append task to TaskItems"]
    B_NEXT["Mark item processed"]

    %% FINAL OUTPUT
    Q_HAS_ASK{"Are there accumulated questions?"}
    Q_HAS_TASK{"Are there accumulated tasks?"}
    Q_HAS_TASK_AFTER_ASK{"Are there accumulated tasks?"}

    B_RESULT_NONE["Do not ask; do not add a task"]
    B_RESULT_ASK["Show AskUserQuestion only"]
    B_RESULT_TASK["Add TaskList items only"]
    B_RESULT_BOTH["Add TaskList items AND show AskUserQuestion"]

    %% EXTRACTION
    B_AGENT_REPLY --> B_EXTRACT
    B_EXTRACT --> B_NORMALIZE
    B_NORMALIZE --> B_INIT
    B_INIT --> Q_MORE_ITEMS
    Q_MORE_ITEMS -->|"Yes"| B_SELECT
    Q_MORE_ITEMS -->|"No"| Q_HAS_ASK
    B_SELECT --> Q_ASK_WALK

    %% QUESTION 1
    Q_ASK_WALK --> Q_EXPLICIT
    Q_EXPLICIT -->|"Yes"| B_ADD_ASK
    Q_EXPLICIT -->|"No"| Q_BLOCKED
    Q_BLOCKED -->|"Yes"| B_ADD_ASK
    Q_BLOCKED -->|"No"| Q_AMBIGUOUS
    Q_AMBIGUOUS -->|"Yes"| B_ADD_ASK
    Q_AMBIGUOUS -->|"No"| Q_PERMISSION
    Q_PERMISSION -->|"Yes"| B_ADD_ASK
    Q_PERMISSION -->|"No"| Q_TASK_WALK

    B_ADD_ASK --> B_NEXT

    %% QUESTION 2
    Q_TASK_WALK --> Q_ACTION
    Q_ACTION -->|"Yes"| Q_OWNED
    Q_ACTION -->|"No"| Q_COMMITMENT
    Q_COMMITMENT -->|"Yes"| Q_OWNED
    Q_COMMITMENT -->|"No"| Q_BUG
    Q_BUG -->|"Yes"| Q_OWNED
    Q_BUG -->|"No"| Q_PENDING
    Q_PENDING -->|"Yes"| Q_OWNED
    Q_PENDING -->|"No"| B_NEXT

    Q_OWNED -->|"Yes"| B_NEXT
    Q_OWNED -->|"No"| Q_TRACKED
    Q_TRACKED -->|"Yes"| B_NEXT
    Q_TRACKED -->|"No"| B_ADD_TASK
    B_ADD_TASK --> B_NEXT

    B_NEXT --> Q_MORE_ITEMS

    %% COMBINE RESULTS
    Q_HAS_ASK -->|"Yes"| Q_HAS_TASK_AFTER_ASK
    Q_HAS_ASK -->|"No"| Q_HAS_TASK

    Q_HAS_TASK_AFTER_ASK -->|"Yes"| B_RESULT_BOTH
    Q_HAS_TASK_AFTER_ASK -->|"No"| B_RESULT_ASK
    Q_HAS_TASK -->|"Yes"| B_RESULT_TASK
    Q_HAS_TASK -->|"No"| B_RESULT_NONE

    %% CLASSES
    classDef decision fill:#fff3c4,stroke:#b8860b,color:#000
    classDef action fill:#ffe0b2,stroke:#e65100,color:#000
    classDef result fill:#d4e4f8,stroke:#1565c0,color:#000

    class Q_MORE_ITEMS,Q_ASK_WALK,Q_EXPLICIT,Q_BLOCKED,Q_AMBIGUOUS,Q_PERMISSION,Q_TASK_WALK,Q_ACTION,Q_COMMITMENT,Q_BUG,Q_PENDING,Q_OWNED,Q_TRACKED,Q_HAS_ASK,Q_HAS_TASK,Q_HAS_TASK_AFTER_ASK decision
    class B_EXTRACT,B_NORMALIZE,B_INIT,B_SELECT,B_ADD_ASK,B_ADD_TASK,B_NEXT action
    class B_AGENT_REPLY,B_RESULT_NONE,B_RESULT_ASK,B_RESULT_TASK,B_RESULT_BOTH result