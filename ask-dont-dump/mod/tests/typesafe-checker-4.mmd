flowchart TD
    B_AGENT_REPLY["Agent reply"]
    B_ASK_WALK["Question 1: Do I need to use AskUserQuestion about something I said in my previous reply?"]
    B_TASK_WALK["Question 2: Do I need to add an item to the session TaskList about something I said in my previous reply?"]
    B_ASK_GATE["Ask gate opens"]
    B_TASK_GATE["Task gate opens"]
    B_NO_GATE["No gate opens from this answer"]
    B_AGENT_REPLY --> B_ASK_WALK
    B_AGENT_REPLY --> B_TASK_WALK

%% %% Question 1, layer 1 query
    Q_ASK_OPEN{"Does the reply leave something for the user to answer or decide?"}
%% %% Question 1, layer 1 choices
    Q_CHOICE_ASK_OPEN_QUESTION["'asks a question'"]
    Q_CHOICE_ASK_OPEN_QUESTION_PASS["> threshold"]
    Q_CHOICE_ASK_OPEN_QUESTION_FAIL["≤ threshold"]
    Q_CHOICE_ASK_OPEN_OFFER["'offers to do something or asks for approval'"]
    Q_CHOICE_ASK_OPEN_OFFER_PASS["> threshold"]
    Q_CHOICE_ASK_OPEN_OFFER_FAIL["≤ threshold"]
    Q_CHOICE_ASK_OPEN_CHOICES["'gives choices with no pick'"]
    Q_CHOICE_ASK_OPEN_CHOICES_PASS["> threshold"]
    Q_CHOICE_ASK_OPEN_CHOICES_FAIL["≤ threshold"]
    Q_CHOICE_ASK_OPEN_GUESS["'states a guess, a gap, or an unconfirmed answer'"]
    Q_CHOICE_ASK_OPEN_GUESS_PASS["> threshold"]
    Q_CHOICE_ASK_OPEN_GUESS_FAIL["≤ threshold"]
    Q_CHOICE_ASK_OPEN_INSTRUCTION["'tells the user to do something'"]
    Q_CHOICE_ASK_OPEN_INSTRUCTION_PASS["> threshold"]
    Q_CHOICE_ASK_OPEN_INSTRUCTION_FAIL["≤ threshold"]
%% %% Question 1, layer 1 logic
    B_ASK_WALK --> Q_ASK_OPEN
    Q_ASK_OPEN --> Q_CHOICE_ASK_OPEN_QUESTION
    Q_ASK_OPEN --> Q_CHOICE_ASK_OPEN_OFFER
    Q_ASK_OPEN --> Q_CHOICE_ASK_OPEN_CHOICES
    Q_ASK_OPEN --> Q_CHOICE_ASK_OPEN_GUESS
    Q_ASK_OPEN --> Q_CHOICE_ASK_OPEN_INSTRUCTION
    Q_CHOICE_ASK_OPEN_QUESTION --> Q_CHOICE_ASK_OPEN_QUESTION_PASS --> Q_ANSWERED
    Q_CHOICE_ASK_OPEN_OFFER --> Q_CHOICE_ASK_OPEN_OFFER_PASS --> Q_ANSWERED
    Q_CHOICE_ASK_OPEN_CHOICES --> Q_CHOICE_ASK_OPEN_CHOICES_PASS --> Q_ANSWERED
    Q_CHOICE_ASK_OPEN_GUESS --> Q_CHOICE_ASK_OPEN_GUESS_PASS --> Q_ANSWERED
    Q_CHOICE_ASK_OPEN_INSTRUCTION --> Q_CHOICE_ASK_OPEN_INSTRUCTION_PASS --> Q_ASKED
    Q_CHOICE_ASK_OPEN_QUESTION --> Q_CHOICE_ASK_OPEN_QUESTION_FAIL --> B_NO_GATE
    Q_CHOICE_ASK_OPEN_OFFER --> Q_CHOICE_ASK_OPEN_OFFER_FAIL --> B_NO_GATE
    Q_CHOICE_ASK_OPEN_CHOICES --> Q_CHOICE_ASK_OPEN_CHOICES_FAIL --> B_NO_GATE
    Q_CHOICE_ASK_OPEN_GUESS --> Q_CHOICE_ASK_OPEN_GUESS_FAIL --> B_NO_GATE
    Q_CHOICE_ASK_OPEN_INSTRUCTION --> Q_CHOICE_ASK_OPEN_INSTRUCTION_FAIL --> B_NO_GATE
%% %% Question 1, layer 2 queries
    Q_ASKED{"Did the user ask for this instruction?"}
    Q_ANSWERED{"Did the user already answer this in an earlier AskUserQuestion?"}
%% %% Question 1, layer 2 choices
    Q_CHOICE_ASKED_YES["'yes, the user asked for it'"]
    Q_CHOICE_ASKED_YES_PASS["> threshold"]
    Q_CHOICE_ASKED_YES_FAIL["≤ threshold"]
    Q_CHOICE_ASKED_NO["'no, the user did not ask for it'"]
    Q_CHOICE_ASKED_NO_PASS["> threshold"]
    Q_CHOICE_ASKED_NO_FAIL["≤ threshold"]
    Q_CHOICE_ANSWERED_YES["'yes, the user already answered it'"]
    Q_CHOICE_ANSWERED_YES_PASS["> threshold"]
    Q_CHOICE_ANSWERED_YES_FAIL["≤ threshold"]
    Q_CHOICE_ANSWERED_NO["'no, the user did not answer it yet'"]
    Q_CHOICE_ANSWERED_NO_PASS["> threshold"]
    Q_CHOICE_ANSWERED_NO_FAIL["≤ threshold"]
%% %% Question 1, layer 2 logic
    %% %% an instruction to the user opens the ask gate, unless the user asked for it
    Q_ASKED --> Q_CHOICE_ASKED_YES
    Q_ASKED --> Q_CHOICE_ASKED_NO
    Q_CHOICE_ASKED_YES --> Q_CHOICE_ASKED_YES_PASS --> B_NO_GATE
    Q_CHOICE_ASKED_NO --> Q_CHOICE_ASKED_NO_PASS --> B_ASK_GATE
    Q_CHOICE_ASKED_YES --> Q_CHOICE_ASKED_YES_FAIL --> B_NO_GATE
    Q_CHOICE_ASKED_NO --> Q_CHOICE_ASKED_NO_FAIL --> B_NO_GATE
    %% %% an open item opens the ask gate, unless the user already answered it
    Q_ANSWERED --> Q_CHOICE_ANSWERED_YES
    Q_ANSWERED --> Q_CHOICE_ANSWERED_NO
    Q_CHOICE_ANSWERED_YES --> Q_CHOICE_ANSWERED_YES_PASS --> B_NO_GATE
    Q_CHOICE_ANSWERED_NO --> Q_CHOICE_ANSWERED_NO_PASS --> B_ASK_GATE
    Q_CHOICE_ANSWERED_YES --> Q_CHOICE_ANSWERED_YES_FAIL --> B_NO_GATE
    Q_CHOICE_ANSWERED_NO --> Q_CHOICE_ANSWERED_NO_FAIL --> B_NO_GATE

%% %% Question 2, layer 1 query
    Q_TASK_OPEN{"Does the reply name a bug or work that is not done?"}
%% %% Question 2, layer 1 choices
    Q_CHOICE_TASK_OPEN_BUG["'a bug or codebase issue'"]
    Q_CHOICE_TASK_OPEN_BUG_PASS["> threshold"]
    Q_CHOICE_TASK_OPEN_BUG_FAIL["≤ threshold"]
    Q_CHOICE_TASK_OPEN_WORK["'work that is not done'"]
    Q_CHOICE_TASK_OPEN_WORK_PASS["> threshold"]
    Q_CHOICE_TASK_OPEN_WORK_FAIL["≤ threshold"]
%% %% Question 2, layer 1 logic
    B_TASK_WALK --> Q_TASK_OPEN
    Q_TASK_OPEN --> Q_CHOICE_TASK_OPEN_BUG
    Q_TASK_OPEN --> Q_CHOICE_TASK_OPEN_WORK
    Q_CHOICE_TASK_OPEN_BUG --> Q_CHOICE_TASK_OPEN_BUG_PASS --> Q_WHO
    Q_CHOICE_TASK_OPEN_WORK --> Q_CHOICE_TASK_OPEN_WORK_PASS --> Q_WHO
    Q_CHOICE_TASK_OPEN_BUG --> Q_CHOICE_TASK_OPEN_BUG_FAIL --> B_NO_GATE
    Q_CHOICE_TASK_OPEN_WORK --> Q_CHOICE_TASK_OPEN_WORK_FAIL --> B_NO_GATE
%% %% Question 2, layer 2 query
    Q_WHO{"Who must act next, and when?"}
%% %% Question 2, layer 2 choices
    Q_CHOICE_WHO_CLAUDE_NOW["'Claude, starting work with several steps now'"]
    Q_CHOICE_WHO_CLAUDE_NOW_PASS["> threshold"]
    Q_CHOICE_WHO_CLAUDE_NOW_FAIL["≤ threshold"]
    Q_CHOICE_WHO_CLAUDE_LATER["'Claude, after this turn'"]
    Q_CHOICE_WHO_CLAUDE_LATER_PASS["> threshold"]
    Q_CHOICE_WHO_CLAUDE_LATER_FAIL["≤ threshold"]
    Q_CHOICE_WHO_HELPER["'a helper, during this turn'"]
    Q_CHOICE_WHO_HELPER_PASS["> threshold"]
    Q_CHOICE_WHO_HELPER_FAIL["≤ threshold"]
    Q_CHOICE_WHO_USER["'the user, after this turn'"]
    Q_CHOICE_WHO_USER_PASS["> threshold"]
    Q_CHOICE_WHO_USER_FAIL["≤ threshold"]
    Q_CHOICE_WHO_NOBODY_DONE["'nobody: the work is done'"]
    Q_CHOICE_WHO_NOBODY_DONE_PASS["> threshold"]
    Q_CHOICE_WHO_NOBODY_DONE_FAIL["≤ threshold"]
    Q_CHOICE_WHO_NOBODY_OPEN["'nobody yet: the work is still open'"]
    Q_CHOICE_WHO_NOBODY_OPEN_PASS["> threshold"]
    Q_CHOICE_WHO_NOBODY_OPEN_FAIL["≤ threshold"]
%% %% Question 2, layer 2 logic
    %% %% work that Claude owes goes to the task list check
    Q_WHO --> Q_CHOICE_WHO_CLAUDE_NOW
    Q_WHO --> Q_CHOICE_WHO_CLAUDE_LATER
    Q_WHO --> Q_CHOICE_WHO_HELPER
    Q_WHO --> Q_CHOICE_WHO_USER
    Q_WHO --> Q_CHOICE_WHO_NOBODY_DONE
    Q_WHO --> Q_CHOICE_WHO_NOBODY_OPEN
    Q_CHOICE_WHO_CLAUDE_NOW --> Q_CHOICE_WHO_CLAUDE_NOW_PASS --> Q_LISTED
    Q_CHOICE_WHO_CLAUDE_LATER --> Q_CHOICE_WHO_CLAUDE_LATER_PASS --> Q_LISTED
    Q_CHOICE_WHO_NOBODY_OPEN --> Q_CHOICE_WHO_NOBODY_OPEN_PASS --> Q_LISTED
    %% %% a helper does it now, the user owns it, or it is done: no task
    Q_CHOICE_WHO_HELPER --> Q_CHOICE_WHO_HELPER_PASS --> B_NO_GATE
    Q_CHOICE_WHO_USER --> Q_CHOICE_WHO_USER_PASS --> B_NO_GATE
    Q_CHOICE_WHO_NOBODY_DONE --> Q_CHOICE_WHO_NOBODY_DONE_PASS --> B_NO_GATE
    Q_CHOICE_WHO_CLAUDE_NOW --> Q_CHOICE_WHO_CLAUDE_NOW_FAIL --> B_NO_GATE
    Q_CHOICE_WHO_CLAUDE_LATER --> Q_CHOICE_WHO_CLAUDE_LATER_FAIL --> B_NO_GATE
    Q_CHOICE_WHO_HELPER --> Q_CHOICE_WHO_HELPER_FAIL --> B_NO_GATE
    Q_CHOICE_WHO_USER --> Q_CHOICE_WHO_USER_FAIL --> B_NO_GATE
    Q_CHOICE_WHO_NOBODY_DONE --> Q_CHOICE_WHO_NOBODY_DONE_FAIL --> B_NO_GATE
    Q_CHOICE_WHO_NOBODY_OPEN --> Q_CHOICE_WHO_NOBODY_OPEN_FAIL --> B_NO_GATE
%% %% Question 2, layer 3 query
    Q_LISTED{"Is all the work Claude owes already on the task list?"}
%% %% Question 2, layer 3 choices
    Q_CHOICE_LISTED_YES["'yes, all of it is on the task list'"]
    Q_CHOICE_LISTED_YES_PASS["> threshold"]
    Q_CHOICE_LISTED_YES_FAIL["≤ threshold"]
    Q_CHOICE_LISTED_NO["'no, some of it is not on the task list'"]
    Q_CHOICE_LISTED_NO_PASS["> threshold"]
    Q_CHOICE_LISTED_NO_FAIL["≤ threshold"]
%% %% Question 2, layer 3 logic
    Q_LISTED --> Q_CHOICE_LISTED_YES
    Q_LISTED --> Q_CHOICE_LISTED_NO
    Q_CHOICE_LISTED_YES --> Q_CHOICE_LISTED_YES_PASS --> B_NO_GATE
    Q_CHOICE_LISTED_NO --> Q_CHOICE_LISTED_NO_PASS --> B_TASK_GATE
    Q_CHOICE_LISTED_YES --> Q_CHOICE_LISTED_YES_FAIL --> B_NO_GATE
    Q_CHOICE_LISTED_NO --> Q_CHOICE_LISTED_NO_FAIL --> B_NO_GATE

%% %% Final step: code reads both answers, no paid question
    Q_GATES{"Which gates are open?"}
    Q_CHOICE_GATES_NONE["no gate is open"]
    Q_CHOICE_GATES_ASK["only the ask gate is open"]
    Q_CHOICE_GATES_TASK["only the task gate is open"]
    Q_CHOICE_GATES_BOTH["both gates are open"]
    B_DO_NOT_BLOCK["Do not block the assistant's reply"]
    B_BLOCK_ASK["Block with plugin message: Your reply leaves something for the user to answer or decide. Use AskUserQuestion to resolve it now."]
    B_BLOCK_TASK["Block with plugin message: Your reply names work that is not done and is not on the task list. Use TaskCreate to add it now."]
    B_BLOCK_BOTH["Block with plugin message: Your reply leaves something for the user to answer or decide, and names work that is not on the task list. Use AskUserQuestion and TaskCreate now."]
    B_ASK_GATE --> Q_GATES
    B_TASK_GATE --> Q_GATES
    B_NO_GATE --> Q_GATES
    Q_GATES --> Q_CHOICE_GATES_NONE --> B_DO_NOT_BLOCK
    Q_GATES --> Q_CHOICE_GATES_ASK --> B_BLOCK_ASK
    Q_GATES --> Q_CHOICE_GATES_TASK --> B_BLOCK_TASK
    Q_GATES --> Q_CHOICE_GATES_BOTH --> B_BLOCK_BOTH

