    class B_AGENT_REPLY,B_ASK_WALK,B_TASK_WALK,B_ASK_GATE,B_TASK_GATE,B_NO_GATE,B_DO_NOT_BLOCK,B_BLOCK_ASK,B_BLOCK_TASK,B_BLOCK_BOTH result
