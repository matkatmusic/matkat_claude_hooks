{
  "debugLoggingEnabled": false,
  "enablements": {
    "block-npm-test": { "PreToolUse": false },
    "block-parent-edits": { "PreToolUse": false },
    "block-bash-edits": { "PreToolUse": false },
    "plan-file-reminder": { "PostToolUse": false },
    "commentCombiner": { "PostToolUse": false },
    "commentCombinerLogger": { "PostToolUse": false },
    "commentLengthLimiter": { "Stop": false },
    "check-task-list-id": { "SessionStart": false },
    "nudge-task-list": { "Stop": false },
    "unlisted-items": { "Stop": false },
    "committed-task-check": { "Stop": false },
    "turn-counter": { "SessionStart": false, "Stop": false, "StopFailure": false, "SessionEnd": false },
    "ponytail-ultra-nudge": { "UserPromptSubmit": false, "PostToolUse": false },
    "clarify-ambiguous": { "UserPromptSubmit": false },
    "task-details": { "UserPromptSubmit": false },
    "pending-task-list": { "UserPromptSubmit": false },
    "in-progress-task-list": { "UserPromptSubmit": false },
    "typecheck-on-stop": { "Stop": false, "SubagentStop": false },
    "debt-ratchet": { "Stop": false, "SubagentStop": false },
    "idle-state-reader": { "UserPromptSubmit": false },
    "idle-state-check": { "Stop": false },
    "anything-for-me": { "session.start": true },
    "ask-dont-dump": { "prompt.submit": true, "turn.complete": true, "session.end": true },
    "idle-state": { "session.start": true, "session.end": true, "prompt.submit": true, "turn.complete": true, "turn.start": true, "tool.call": true, "command.run": true },
    "context-exit": { "turn.complete": true },
    "bug-report": { "prompt.submit": true },
    "feature-request": { "prompt.submit": true },
    "change-request": { "prompt.submit": true },
    "ask-if-unclear": { "prompt.submit": true }
  },
  "values": {
    "shared": { "CLAUDE_HOOKS_SESSION_STATE_DIR": "~/.claude/claude_hooks" },
    "block-npm-test": {
      "CLAUDE_HOOKS_BLOCK_NPM_TEST_LOG_DIR": "/tmp/tasktools-npm-test",
      "CLAUDE_HOOKS_BLOCK_NPM_TEST_KILL_AFTER_SECONDS": "3600",
      "CLAUDE_HOOKS_BLOCK_NPM_TEST_TEST_TIMEOUT_MS": "120000",
      "CLAUDE_HOOKS_BLOCK_NPM_TEST_LOG_MAX_AGE_MS": "604800000"
    },
    "block-parent-edits": {
      "CLAUDE_HOOKS_BLOCKED_EDITS_DIR": "~/.claude/claude_hooks/blocked-edits"
    },
    "debt-ratchet": {
      "CLAUDE_HOOKS_DEBT_RATCHET_LEDGER_DIR": "~/.claude/array-debt",
      "CLAUDE_HOOKS_DEBT_RATCHET_LEDGER_MAX_AGE_MS": "604800000",
      "CLAUDE_HOOKS_DEBT_RATCHET_MAX_FILE_LINES": "1000",
      "CLAUDE_HOOKS_DEBT_RATCHET_DEBT_TARGET": "0",
      "CLAUDE_HOOKS_DEBT_RATCHET_FIX_BATCH_SIZE": "10",
      "CLAUDE_HOOKS_DEBT_RATCHET_MIN_FILE_DEBT": "10"
    },
    "idle-state-reader": {
      "CLAUDE_HOOKS_IDLE_STATE_WINDOW_MS": "86400000"
    },
    "idle-state": {
      "CLAUDE_HOOKS_IDLE_MINUTES": "55"
    },
    "context-exit": {
      "CLAUDE_HOOKS_CONTEXT_EXIT_WARNING_PERCENTS": "30,50,80"
    },
    "ask-dont-dump": { "useTypesafe": false, "typesafeQuestions": "hooks/typesafeQuestions.json" },
    "plan-file-reminder": {
      "CLAUDE_HOOKS_PLANNING_GUIDE_PATH": "../plan-file-reminder/planning.md"
    },
    "turn-counter": {
      "CLAUDE_HOOKS_STATUS_LINE_SCRATCH_ROOT": "/tmp",
      "CLAUDE_HOOKS_STATUS_LINE_KEEP_DAYS": "14"
    },
    "commentLengthLimiter": {
      "CLAUDE_HOOKS_REFLOW_MAX_REWRITES": "2"
    },
    "typecheck-on-stop": {
      "CLAUDE_HOOKS_TYPECHECK_MAX_ERROR_LINES": "20"
    },
    "unlisted-items": {
      "CLAUDE_HOOKS_UNLISTED_MIN_WORD_LENGTH": "5",
      "CLAUDE_HOOKS_UNLISTED_MIN_SHARED_WORDS": "2",
      "CLAUDE_HOOKS_TASKS_DIR": "~/.claude/tasks"
    },
    "claude-team": {
      "CLAUDE_HOOKS_CLAUDE_TEAM_DIRECTOR_MODEL": "fable",
      "CLAUDE_HOOKS_CLAUDE_TEAM_DIRECTOR_JOB": "orchestrator",
      "CLAUDE_HOOKS_CLAUDE_TEAM_DIRECTOR_PROMPT": "You are the orchestrator/director.\nUse helper agents in this way:\n- Use Haiku agents to read files and find things.\n- Use sonnet agents to write/create plans.\n- use Opus agents to verify/judge plans.\n- use Adversarial Opus agents to critique plans that Opus approves.\n- use Sonnet agents to edit plans.\n- use sonnet agents to build opus-approved plans.",
      "CLAUDE_HOOKS_CLAUDE_TEAM_JOBS": "readers,planner,verifier,adversary,builder",
      "CLAUDE_HOOKS_CLAUDE_TEAM_READERS_MODEL": "sonnet",
      "CLAUDE_HOOKS_CLAUDE_TEAM_PLANNER_MODEL": "sonnet",
      "CLAUDE_HOOKS_CLAUDE_TEAM_VERIFIER_MODEL": "opus",
      "CLAUDE_HOOKS_CLAUDE_TEAM_ADVERSARY_MODEL": "opus",
      "CLAUDE_HOOKS_CLAUDE_TEAM_BUILDER_MODEL": "sonnet",
      "CLAUDE_HOOKS_CLAUDE_TEAM_READERS_PROMPT": "You are the reader director. Start Haiku helper agents (readers and finders) as needed. Report back to the chat that asked.",
      "CLAUDE_HOOKS_CLAUDE_TEAM_PLANNER_PROMPT": "You are the planner. You create plans. Edits from the verifier and the adversary come back to you.",
      "CLAUDE_HOOKS_CLAUDE_TEAM_VERIFIER_PROMPT": "You are the verifier. You verify the plans that the planner creates.",
      "CLAUDE_HOOKS_CLAUDE_TEAM_ADVERSARY_PROMPT": "You are the adversary. You adversarially judge the plans that the verifier approves. Send any edits back to the planner.",
      "CLAUDE_HOOKS_CLAUDE_TEAM_BUILDER_PROMPT": "You are the builder. You build the plans that the verifier and the adversary approved.",
      "CLAUDE_HOOKS_CLAUDE_TEAM_SEND_INSTRUCTIONS": "You are the chat \"{chatName}\" in the team \"{teamName}\". Your job is {job}.\nThe jobs in this team are: {jobs}.\nTo send a message to a job, run this command: bun {sendScript} <job> \"<text>\"\nThe chat for a job starts the first time a message is sent to that job.\nA message from another chat starts with [claude-team].",
      "CLAUDE_HOOKS_CLAUDE_TEAM_MESSAGE_HEADER": "[claude-team] From \"{senderChatName}\" (job {senderJob}). To reply, send to the job {senderJob}.",
      "CLAUDE_HOOKS_CLAUDE_TEAM_DIALOG_WAIT_SECONDS": "600",
      "CLAUDE_HOOKS_CLAUDE_TEAM_START_WAIT_SECONDS": "300"
    }
  },
  "hooks": [
    { "event": "PreToolUse", "matcher": "Bash", "command": ["node", "../block-npm-test/block-npm-test.ts"], "timeout": 300 },
    { "event": "PreToolUse", "matcher": "Edit|Write|NotebookEdit|Bash", "command": ["node", "../block-parent-edits/block-parent-edits.ts"] },
    { "event": "PreToolUse", "matcher": "Bash", "command": ["node", "../block-bash-edits/block-bash-edits.ts"] },
    { "event": "PostToolUse", "matcher": "Write|Edit|MultiEdit|NotebookEdit", "command": ["node", "../plan-file-reminder/plan-file-reminder.ts"] },
    { "event": "PostToolUse", "matcher": "Edit|Write|NotebookEdit", "command": ["node", "../comment-length-limiter/commentCombiner.ts"] },
    { "event": "PostToolUse", "matcher": "Edit|Write|NotebookEdit", "command": ["node", "../comment-length-limiter/commentCombinerLogger.ts"] },
    { "event": "Stop", "command": ["node", "../comment-length-limiter/commentLengthLimiter.ts"] },
    { "event": "SessionStart", "command": ["node", "../check-task-list-id/check-task-list-id.ts"] },
    { "event": "Stop", "command": ["node", "../nudge-task-list/nudge-task-list.ts"] },
    { "event": "Stop", "command": ["node", "../unlisted-items/unlisted-items.ts"] },
    { "event": "Stop", "command": ["node", "../committed-task-check/committed-task-check.ts"] },
    { "event": "SessionStart", "command": ["node", "../status-line/turn-counter.ts"] },
    { "event": "Stop", "command": ["node", "../status-line/turn-counter.ts"] },
    { "event": "StopFailure", "command": ["node", "../status-line/turn-counter.ts"] },
    { "event": "SessionEnd", "command": ["node", "../status-line/turn-counter.ts"] },
    { "event": "UserPromptSubmit", "command": ["node", "../ponytail-ultra-nudge/ponytail-ultra-nudge.ts"] },
    { "event": "PostToolUse", "matcher": "Skill", "command": ["node", "../ponytail-ultra-nudge/ponytail-ultra-nudge.ts"] },
    { "event": "UserPromptSubmit", "command": ["node", "../clarify-ambiguous/clarify-ambiguous.ts"] },
    { "event": "UserPromptSubmit", "command": ["node", "../task-details/task-details.ts"] },
    { "event": "UserPromptSubmit", "command": ["node", "../pending-task-list/pending-task-list.ts"] },
    { "event": "UserPromptSubmit", "command": ["node", "../in-progress-task-list/in-progress-task-list.ts"] },
    { "event": "Stop", "command": ["node", "../typecheck-on-stop/typecheck-on-stop.ts"], "timeout": 300 },
    { "event": "SubagentStop", "command": ["node", "../typecheck-on-stop/typecheck-on-stop.ts"], "timeout": 300 },
    { "event": "Stop", "command": ["node", "../debt-ratchet/debt-ratchet.ts"], "timeout": 300 },
    { "event": "SubagentStop", "command": ["node", "../debt-ratchet/debt-ratchet.ts"], "timeout": 300 },
    { "event": "UserPromptSubmit", "command": ["node", "../idle-state/idle-state-reader.ts"] },
    { "event": "Stop", "command": ["node", "../idle-state/idle-state-check.ts"] }
  ]
}
